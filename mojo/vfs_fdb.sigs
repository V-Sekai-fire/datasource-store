# Contract surface of mojo/src/vfs_fdb.mojo: the entry points the Mojo VFS exports.
#
# ROLE: source of truth, kept by hand. `check_mojo_surface.sh` fails when a def below is
# added to or removed from the source without a line here, and `--self-test` shows it can.
# RUNG: 0, names only. Argument and return types are not checked yet.
#
# One name per line, `#` starts a comment. The C counterparts are in `weft_fdb_vfs.h`.

# Registration: makes the VFS known to SQLite.
register_fdb

# Group commit across databases (the C `weft_txn_*`).
weft_txn_begin
weft_txn_join
weft_txn_commit
weft_txn_abort

# File methods, called by SQLite through a function pointer.
fdb_close
fdb_read
fdb_write
fdb_truncate
fdb_sync
fdb_file_size
fdb_device_chars

# VFS methods, called by SQLite through a function pointer.
vfs_open
vfs_delete
vfs_access
